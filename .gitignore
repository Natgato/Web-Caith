# Secrets and local environment
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# Installed dependencies and generated frontend files
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage

# Local databases, dumps and backups
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
/*.sql
/database/*.sql
*.sql.gz
/backups/

# Logs and runtime caches (storage subdirectories have their own .gitignore)
*.log
/.phpunit.cache/
.phpunit.result.cache
/storage/pail/
.phpactor.json

# Local design tooling; retain only intentional design documentation
/.impeccable/*
!/.impeccable/design.json
!/.impeccable/asset-provenance.md
!/.impeccable/community-asset-provenance.md
!/.impeccable/surfaces/
/.impeccable/surfaces/*
!/.impeccable/surfaces/*.md
/.taste-skill/

# Editor and OS metadata
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
