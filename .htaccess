Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} /$
    RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]
    RewriteRule ^$ %{REQUEST_URI}/public/ [R=302,L]
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
