    {
      "name": "Admin sidebar",
      "kind": "nav",
      "refersTo": "admin-sidebar",
      "description": "Orientación privada con sección activa y acceso público.",
      "html": "<aside class=\"ds-sidebar\"><a class=\"ds-admin-brand\" href=\"#\">Casa CAITH</a><p>Administración editorial</p><nav aria-label=\"Panel administrativo\"><a href=\"#\">Resumen</a><a href=\"#\" aria-current=\"page\">Páginas institucionales</a><a href=\"#\">Contacto y privacidad</a><a href=\"/Web-Caith/public\">Ver sitio público</a></nav></aside>",
      "css": ".ds-sidebar{font-family:var(--body,Barlow,sans-serif);background:var(--wine,#701f35);color:var(--paper,#f4ebdd);padding:32px 24px;width:212px}.ds-sidebar a{color:inherit;text-decoration:none}.ds-admin-brand{display:block;font-size:28px;font-weight:800;line-height:1;letter-spacing:-.03em}.ds-sidebar p{font-size:15px;margin-top:12px}.ds-sidebar nav{display:grid;gap:3px;margin-top:24px}.ds-sidebar nav a{font-size:16px;line-height:1.35;padding:10px 8px;min-height:42px}.ds-sidebar nav a[aria-current]{background:var(--wine-deep,#531426)}.ds-sidebar a:hover{text-decoration:underline}.ds-sidebar a:focus-visible{outline:2px solid currentColor;outline-offset:6px}@media(max-width:960px){.ds-sidebar{width:auto}.ds-sidebar nav{display:flex;flex-wrap:wrap;gap:4px 12px}}"
    },
    {
      "name": "Dashboard count tile",
      "kind": "card",
      "refersTo": "dashboard-item",
      "description": "Conteo real de registros web; el ejemplo representa un módulo vacío.",
      "html": "<a class=\"ds-dashboard\" href=\"#\"><h2>Páginas institucionales</h2><strong>0</strong><p>0 en borrador o revisión</p></a>",
      "css": ".ds-dashboard{font-family:var(--body,Barlow,sans-serif);display:block;background:var(--soft,#eadfd2);padding:26px;color:var(--ink,#30282a);text-decoration:none}.ds-dashboard h2{font-size:22px;font-weight:600;line-height:1.2;margin:0 0 18px;color:var(--wine,#701f35)}.ds-dashboard strong{font-size:44px;font-weight:700;line-height:1;color:var(--wine,#701f35)}.ds-dashboard p{font-size:16px;margin:12px 0 0}.ds-dashboard:hover h2{text-decoration:underline}.ds-dashboard:focus-visible{outline:2px solid currentColor;outline-offset:6px}"
    },
    {
      "name": "Management table",
      "kind": "custom",
      "refersTo": "data-table",
