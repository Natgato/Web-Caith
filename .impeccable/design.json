  "components": [
    {
      "name": "Text link CTA",
      "kind": "custom",
      "refersTo": "text-link",
      "description": "Enlace editorial subrayado con flecha diagonal.",
      "html": "<a class=\"ds-text-link\" href=\"/Web-Caith/public/nosotros/historia\">Conoce nuestra historia <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-text-link{font-family:var(--body, 'Barlow', sans-serif);display:inline-flex;align-items:center;gap:24px;min-height:48px;color:var(--wine,#701f35);font-size:18px;font-weight:600;text-decoration:underline;text-underline-offset:.25em;text-decoration-thickness:1px}.ds-text-link svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;transition:transform 250ms cubic-bezier(.16,1,.3,1)}.ds-text-link:hover svg{transform:translate(3px,-3px)}.ds-text-link:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-text-link:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-text-link svg{transition:none}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Navegación pública multipágina; menú hasta 960px.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><a href=\"/Web-Caith/public/nosotros\">Nosotros</a><a href=\"/Web-Caith/public/nuestra-labor\">Nuestra labor</a><a href=\"/Web-Caith/public/realidad-social\">Realidad social</a><a href=\"/Web-Caith/public/explorar\">Explora</a><a class=\"ds-nav-action\" href=\"/Web-Caith/public/como-ayudar\">Participa</a></nav>",
      "css": ".ds-nav{font-family:var(--body, 'Barlow', sans-serif);display:flex;flex-wrap:wrap;align-items:center;gap:24px;color:var(--ink,#30282a)}.ds-nav a{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:17px;font-weight:500;color:inherit;text-decoration:none;text-underline-offset:.25em}.ds-nav .ds-nav-action,.ds-nav a:hover{color:var(--wine,#701f35)}.ds-nav a:hover,.ds-nav a[aria-current]{text-decoration:underline}.ds-nav a:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-nav a:active{transform:translateY(1px)}.ds-nav svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}"
    },
    {
      "name": "History year controls",
      "kind": "custom",
      "refersTo": "history-control",
      "description": "Selector de etapas en la página de cronología; no en la portada.",
      "html": "<div class=\"ds-years\" role=\"group\" aria-label=\"Elige una etapa de la historia\"><button type=\"button\" aria-pressed=\"true\">1994</button><button type=\"button\" aria-pressed=\"false\">2001</button><button type=\"button\" aria-pressed=\"false\">2020</button></div>",
      "css": ".ds-years{display:flex;gap:48px;background:var(--wine,#701f35);color:var(--paper,#f4ebdd)}.ds-years button{font-family:var(--body, 'Barlow', sans-serif);padding:5px 0;min-height:48px;border:0;background:transparent;font-size:24px;color:inherit;opacity:.7;cursor:pointer;font-variant-numeric:tabular-nums}.ds-years button[aria-pressed=\"true\"]{opacity:1;text-decoration:underline;text-underline-offset:10px;text-decoration-thickness:2px}.ds-years button:hover{opacity:1}.ds-years button:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-years button:active{transform:translateY(1px)}@media(max-width:760px){.ds-years{gap:36px}}"
    },
    {
      "name": "Mobile menu toggle",
      "kind": "button",
      "refersTo": "menu-toggle",
      "description": "Menú público hasta 960px; estado expandido conectado por JavaScript.",
      "html": "<button class=\"ds-menu\" type=\"button\" aria-expanded=\"false\"><span>Menú</span><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M4 8h16M4 16h16\"/></svg></button>",
      "css": ".ds-menu{font-family:var(--body, 'Barlow', sans-serif);display:inline-flex;align-items:center;gap:10px;min-height:44px;border:0;padding:10px 0 10px 16px;background:transparent;font-size:18px;color:var(--ink,#30282a);cursor:pointer;transition:color 180ms,transform 180ms}.ds-menu svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}.ds-menu:hover{color:var(--ink,#30282a)}.ds-menu:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-menu:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-menu{transition:none}}"
    },
    {
      "name": "Footer",
      "kind": "custom",
      "refersTo": "footer",
      "description": "Pie público con enlaces institucionales y aclaración de ilustraciones conceptuales.",
      "html": "<footer class=\"ds-footer\"><a class=\"ds-footer-name\" href=\"/Web-Caith/public\">Casa CAITH</a><nav class=\"ds-footer-links\" aria-label=\"Enlaces institucionales\"><a href=\"/Web-Caith/public/contacto\">Contacto</a><a href=\"/Web-Caith/public/privacidad\">Privacidad y retiro de datos</a><a href=\"/Web-Caith/public/donaciones\">Donaciones: próximamente</a><a href=\"/Web-Caith/public/admin/login\">Administración</a></nav><div class=\"ds-footer-bottom\"><p>Un programa del Centro Yanapanakusun.</p><a href=\"#inicio\">Volver arriba</a><p>Cusco, Perú</p></div><p class=\"ds-disclosure\">Propuesta para revisión institucional. Las ilustraciones y sus personajes son conceptuales; no representan a beneficiarias reales ni documentan las instalaciones.</p></footer>",
      "css": ".ds-footer{font-family:var(--body, 'Barlow', sans-serif);background:var(--wine,#701f35);color:var(--paper,#f4ebdd);padding:54px 24px 32px}.ds-footer a{color:inherit;text-underline-offset:.25em}.ds-footer-name{display:block;font-size:clamp(62px,14.2vw,220px);font-weight:800;line-height:.98;letter-spacing:-.04em;white-space:nowrap;text-decoration:none}.ds-footer-name:hover{opacity:.85}.ds-footer a:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-footer a:active{transform:translateY(1px)}.ds-footer-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:24px;margin-top:42px;font-size:16px}.ds-footer-bottom p{margin:0}.ds-footer-bottom a{display:inline-flex;align-items:center;gap:8px;padding-block:8px}.ds-footer-bottom svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}@media(max-width:760px){.ds-footer{padding-block:40px 28px}.ds-footer-name{font-size:14vw}.ds-footer-bottom{gap:12px 24px;margin-top:28px}}.ds-footer-links{display:flex;gap:18px 32px;flex-wrap:wrap;margin-top:36px}.ds-footer-links a{min-height:44px;display:inline-flex;align-items:center}.ds-disclosure{font-size:14px;line-height:1.5;margin-top:24px;max-width:80ch}"
    },
    {
      "name": "Poster headline",
      "kind": "custom",
      "refersTo": "hero-headline",
      "description": "Titular de cartel del hero; Barlow 800, sin marco.",
      "html": "<h1 class=\"ds-hero-title\">Un lugar<br>para crecer.</h1>",
      "css": ".ds-hero-title{margin:0;font-family:var(--body,Barlow,sans-serif);font-weight:800;font-size:clamp(80px,7.7vw,120px);line-height:.89;letter-spacing:-.035em;text-transform:uppercase;color:var(--wine,#701f35)}@media(max-width:1050px){.ds-hero-title{font-size:clamp(60px,7.5vw,80px)}}@media(max-width:760px){.ds-hero-title{font-size:clamp(47px,9.8vw,72px);line-height:.91}}@media(max-width:380px){.ds-hero-title{font-size:42px}}"
    },
    {
      "name": "Outlined poster lettering",
      "kind": "custom",
      "refersTo": "poster-lettering",
      "description": "Anotación decorativa sin caja, girada −8°; en móvil comparte fila con la fecha antes de la escena.",
      "html": "<p class=\"ds-poster-note\" aria-hidden=\"true\">Crecer<br>juntas.</p>",
      "css": ".ds-poster-note{display:inline-block;margin:24px;font:800 48px/.88 var(--body,Barlow,sans-serif);letter-spacing:-.035em;text-transform:uppercase;transform:rotate(-8deg);color:var(--paper,#f4ebdd);-webkit-text-stroke:2.2px var(--wine,#701f35);paint-order:stroke fill}@media(max-width:1050px){.ds-poster-note{font-size:38px}}@media(max-width:760px){.ds-poster-note{font-size:28px;-webkit-text-stroke-width:1.4px}}@media(max-width:380px){.ds-poster-note{font-size:26px}}"
    },
    {
      "name": "Community illustration and annotations",
      "kind": "custom",
      "refersTo": "community-illustration",
      "description": "Escena conceptual de convivencia en tinta y semitonos, con palabras decorativas sin acción.",
      "html": "<figure class=\"ds-community-scene\"><img src=\"http://localhost/Web-Caith/public/images/caith-convivencia.png\" alt=\"Ilustración conceptual de jóvenes y una educadora compartiendo libros y cuadernos alrededor de una mesa\" width=\"1536\" height=\"1024\"><figcaption class=\"ds-scene-words\" aria-hidden=\"true\"><span>Aprender.</span><span>Compartir.</span><span>Decidir.</span></figcaption></figure>",
      "css": ".ds-community-scene{width:52%;margin:0}.ds-community-scene img{display:block;width:100%;max-width:100%;height:auto;margin:0}.ds-scene-words{display:flex;justify-content:space-around;gap:16px;margin-top:8px;padding-inline:10%;color:var(--wine,#701f35);font:italic 500 27px/1.1 var(--display,\"Cormorant Garamond\",Georgia,serif)}.ds-scene-words span:first-child{transform:rotate(-7deg)}.ds-scene-words span:nth-child(2){transform:rotate(4deg)}.ds-scene-words span:last-child{transform:rotate(-3deg)}@media(max-width:1050px){.ds-community-scene{width:57%}.ds-scene-words{font-size:24px;padding-inline:4%;gap:8px}}@media(max-width:760px){.ds-community-scene{width:100%;padding-bottom:26px}.ds-scene-words{font-size:23px;margin-top:14px;padding-inline:var(--gutter,24px)}}"
    },
    {
      "name": "Editorial entry",
      "kind": "custom",
      "refersTo": "editorial-entry",
      "description": "Acceso público abierto con título, resumen y flecha.",
      "html": "<a class=\"ds-entry\" href=\"/Web-Caith/public/nosotros\"><h3>Nosotros <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></h3><p>La casa, sus orígenes y su relación con el Centro Yanapanakusun.</p></a>",
      "css": ".ds-entry{font-family:var(--body,Barlow,sans-serif);display:block;text-decoration:none;max-width:55ch;padding-block:8px;color:var(--ink,#30282a)}.ds-entry h3{display:flex;align-items:baseline;gap:16px;justify-content:space-between;font-size:28px;font-weight:600;line-height:1.15;letter-spacing:-.02em;margin:0 0 14px;color:var(--wine,#701f35)}.ds-entry p{font-size:18px;margin:0}.ds-entry svg{fill:none;stroke:currentColor;stroke-width:1.5;flex-shrink:0;transition:transform 200ms}.ds-entry:hover h3{text-decoration:underline;text-underline-offset:6px}.ds-entry:hover svg{transform:translate(3px,-3px)}.ds-entry:focus-visible{outline:2px solid currentColor;outline-offset:6px}@media(max-width:760px){.ds-entry h3{font-size:25px}}@media(prefers-reduced-motion:reduce){.ds-entry svg{transition:none}}"
    },
    {
      "name": "Form field",
      "kind": "input",
      "refersTo": "field",
      "description": "Campo etiquetado compartido por formularios públicos y privados.",
      "html": "<div class=\"ds-field\"><label for=\"ds-name\">Nombres y apellidos <span aria-hidden=\"true\">*</span></label><input id=\"ds-name\" name=\"name\" required autocomplete=\"name\"></div>",
      "css": ".ds-field{font-family:var(--body,Barlow,sans-serif);display:flex;flex-direction:column;gap:8px;margin-bottom:22px;color:var(--ink,#30282a)}.ds-field label{font-weight:500}.ds-field input{font:400 18px/1.4 var(--body,Barlow,sans-serif);color:var(--ink,#30282a);background:var(--paper,#f4ebdd);border:1px solid var(--muted,#65534e);border-radius:0;min-height:48px;padding:12px 14px;max-width:100%;caret-color:var(--wine,#701f35)}.ds-field input:focus-visible{outline:2px solid var(--wine,#701f35);outline-offset:3px}.ds-field input[aria-invalid=true]{border:2px solid var(--wine,#701f35)}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de formulario o navegación de tarea.",
      "html": "<button type=\"button\" class=\"ds-button\">Guardar contenido</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--wine,#701f35);color:var(--paper,#f4ebdd);border:0;padding:13px 22px;min-height:48px;font:600 18px/1.3 var(--body,Barlow,sans-serif);cursor:pointer}.ds-button:hover{background:var(--wine-deep,#531426)}.ds-button:focus-visible{outline:2px solid currentColor;outline-offset:6px}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{opacity:.6;cursor:wait}"
